APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production multi-sous-domaines recruteur : SESSION_DOMAIN=.jbis.cm

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Dev: database (ou sync pour tout immédiat). Prod o2switch: redis recommandé.
QUEUE_CONNECTION=database
QUEUE_MAIL=default

# Local : database | Production o2switch : redis
CACHE_STORE=database
CACHE_PREFIX=jbis_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
# o2switch : chemin socket dans REDIS_HOST (pas REDIS_URL, pas REDIS_UNIX_SOCKET)
REDIS_HOST=/home/sc1tcjo2411/.cpanel/redis/redis.sock
REDIS_PASSWORD=
REDIS_PORT=0
REDIS_URL=
REDIS_UNIX_SOCKET=
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=contact@jbis.cm
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=contact@jbis.cm
MAIL_FROM_NAME="Job Best International Services"

# Adresses Google Workspace @jbis.cm (alias « Envoyer en tant que » sur MAIL_USERNAME)
JBIS_MAIL_DOMAIN=jbis.cm
JBIS_MAIL_CONTACT=contact@jbis.cm
JBIS_MAIL_INFO=info@jbis.cm
JBIS_MAIL_NOREPLY=no-reply@jbis.cm
JBIS_MAIL_DPO=dpo@jbis.cm
JBIS_MAIL_YAOUNDE=yaounde@jbis.cm
JBIS_MAIL_DOUALA=douala@jbis.cm
JBIS_MAIL_STAFF=staff@jbis.cm
# Google Workspace : créer un mot de passe d'application pour MAIL_USERNAME (2FA requis).
# Admin Workspace → chaque adresse secondaire = alias ou « Envoyer en tant que » sur contact@jbis.cm.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


GOOGLE_CLIENT_ID=votre_id_google_ici
GOOGLE_CLIENT_SECRET=votre_secret_google_ici
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Media (Cloudinary + miroir local) ---
# Active/désactive globalement Cloudinary. Mettre à false bascule TOUTES les
# URLs media sur assets.jbis.cm sans modifier la donnée stockée.
CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud_name>
CLOUDINARY_ENABLED=true
CLOUDINARY_PREFIX=jbis.cm

ASSETS_DOMAIN=https://assets.jbis.cm
ASSETS_PATH=/home/sc1tcjo2411/jbis/assets.jbis.cm

# --- PDF Process Flow (Blade dans l'API → service jbis-screenshot) ---
PROCESS_FLOW_PDF_PAPER=a4
SCREENSHOT_SERVICE_URL=http://127.0.0.1:3100
SCREENSHOT_SERVICE_TOKEN=change-me-local-dev-token
SCREENSHOT_SERVICE_TIMEOUT=120

# --- iLovePDF (PDF processing : compress / merge / split / protect / watermark / convert) ---
# Clés à récupérer sur https://developer.ilovepdf.com (Projects)
ILOVEPDF_PUBLIC_KEY=
ILOVEPDF_SECRET_KEY=
ILOVEPDF_TIMEOUT=60

# --- IA (LLM) : driver gemini | groq | fake (tests) ---
# https://aistudio.google.com/api-keys
# AI_DRIVER=gemini
# AI_GEMINI_API_KEY=
# AI_GEMINI_MODEL=gemini-2.0-flash
# AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# AI_GEMINI_TIMEOUT=60
# https://console.groq.com/docs/
# AI_DRIVER=groq
# AI_GROQ_API_KEY=
# AI_GROQ_MODEL=llama-3.3-70b-versatile
# AI_GROQ_BASE_URL=https://api.groq.com/openai/v1
# AI_GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# AI_DOCUMENT_EXTRACTION_ENABLED=true
# AI_DOCUMENT_EXTRACTION_DRIVER=groq
# base64 (défaut, local + prod) ou url (assets publics type https://assets.jbis.cm)
# AI_DOCUMENT_EXTRACTION_VISION_INPUT=base64
# AI_DOCUMENT_EXTRACTION_PDF_ENABLED=true
# AI_DOCUMENT_EXTRACTION_PDF_MAX_PAGES=2
# AI_DOCUMENT_EXTRACTION_PDF_MIN_TEXT_CHARS=200
# AI_FAKE_RESPONSE="Réponse simulée (driver fake)."
# Brouillon JSON simulé pour les workflows structurés : clé `structured_stub` dans config/ai.php (pas d'ENV dédié).

# SMS_PROVIDER=queen_sms
# QUEENSMS_BASE_URL=https://api.queensms.net/v1
# QUEENSMS_API_KEY=
# QUEENSMS_SENDER_ID=
# QUEENSMS_TIMEOUT=10
#
# CPANEL_DOMAIN=hostname.exemple.com
# CPANEL_USER=cpanel_username
# CPANEL_TOKEN=cpanel_api_token
# CPANEL_PRIMARY_DOMAIN=example.com
# CPANEL_TIMEOUT=15
# (Sous-domaines recruteur désactivés — portail partagé FRONTEND_URL/recruiter)
#
# SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,jbis.cm
#
# --- Portail recruteur ---
# RECRUITER_ONBOARDING_ENABLED=true
# RECRUITER_PORTAL_NOTIFY_EMAIL utilise JBIS_MAIL_CONTACT si vide
# RECRUITER_PORTAL_NOTIFY_EMAIL=contact@jbis.cm
#
# --- Newsletter ---
# NEWSLETTER_UNSUBSCRIBE_URL="${FRONTEND_URL}/newsletter/unsubscribe"
# NEWSLETTER_CAMEROON_COUNTRY_CODE=CM
# NEWSLETTER_MAX_OFFERS_PER_SECTION=8
# NEWSLETTER_OFFER_LOOKBACK_DAYS=14
# NEWSLETTER_SCHEDULE_ENABLED=true

VITE_APP_NAME="${APP_NAME}"
