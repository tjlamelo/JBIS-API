APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


GOOGLE_CLIENT_ID=votre_id_google_ici
GOOGLE_CLIENT_SECRET=votre_secret_google_ici
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Media (Cloudinary + miroir local) ---
# Active/désactive globalement Cloudinary. Mettre à false bascule TOUTES les
# URLs media sur assets.jbis.cm sans modifier la donnée stockée.
CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud_name>
CLOUDINARY_ENABLED=true
CLOUDINARY_PREFIX=jbis.cm

ASSETS_DOMAIN=https://assets.jbis.cm
ASSETS_PATH=/home/sc1tcjo2411/jbis/assets.jbis.cm

# --- PDF Process Flow (Blade dans l'API → service jbis-screenshot) ---
PROCESS_FLOW_PDF_PAPER=a4
SCREENSHOT_SERVICE_URL=http://127.0.0.1:3100
SCREENSHOT_SERVICE_TOKEN=change-me-local-dev-token
SCREENSHOT_SERVICE_TIMEOUT=120

# --- iLovePDF (PDF processing : compress / merge / split / protect / watermark / convert) ---
# Clés à récupérer sur https://developer.ilovepdf.com (Projects)
ILOVEPDF_PUBLIC_KEY=
ILOVEPDF_SECRET_KEY=
ILOVEPDF_TIMEOUT=60

# --- IA (LLM) : driver gemini (Google AI Studio) ou fake pour tests ---
# https://aistudio.google.com/api-keys
# AI_DRIVER=gemini
# AI_GEMINI_API_KEY=
# AI_GEMINI_MODEL=gemini-2.0-flash
# AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# AI_GEMINI_TIMEOUT=60
# AI_FAKE_RESPONSE="Réponse simulée (driver fake)."
# Brouillon JSON simulé pour les workflows structurés : clé `structured_stub` dans config/ai.php (pas d'ENV dédié).

# SMS_PROVIDER=queen_sms
# QUEENSMS_BASE_URL=https://api.queensms.net/v1
# QUEENSMS_API_KEY=
# QUEENSMS_SENDER_ID=
# QUEENSMS_TIMEOUT=10
#
# CPANEL_DOMAIN=hostname.exemple.com
# CPANEL_USER=cpanel_username
# CPANEL_TOKEN=cpanel_api_token
# CPANEL_PRIMARY_DOMAIN=example.com
# CPANEL_TIMEOUT=15

VITE_APP_NAME="${APP_NAME}"
